# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Remote Skill Market service base URL. CCUI appends /data-agent/api/skill/... paths.
# http:// and https:// are both supported.
# SKILL_MARKET_BASE_URL=https://xxxxxx
# Remote Skill Market authorization. Leave blank for local mock development.
# Authorization scheme is fixed to CLOUDSOA-HMAC-SHA256.
# SKILL_MARKET_AUTH_APPID=
# SKILL_MARKET_AUTH_KEY=
# Skill Market backend log level: silent, error, warn, info, debug.
# SKILL_MARKET_LOG_LEVEL=warn
# For the local mock service:
# SKILL_MARKET_BASE_URL=http://127.0.0.1:3101

# Remote SQL Check service base URL. CCUI appends /sql-check/rules.
# Leave blank when another gateway serves /sql-check/rules on the same origin as CCUI.
# For the local mock service:
# SQL_CHECK_BASE_URL=http://127.0.0.1:3102
# SQL_CHECK_MOCK_PORT=3102

# CodeHub MCP endpoint and default host. Internal values are deployment-specific.
# CODEHUB_MCP_URL=https://codehub-mcp.example.internal/jsonrpc
# CODEHUB_HOST=https://codehub.example.internal
# CODEHUB_HEADER_PYTHON=python3
# CODEHUB_HEADER_SCRIPT=scripts/code-header.py
# CODEHUB_MR_POLLER_ENABLED=true
# CODEHUB_MR_POLL_INTERVAL_HOURS=4
# CODEHUB_MR_EXPIRE_DAYS=7
# CODEHUB_MR_POLL_BATCH_LIMIT=50
# CODEHUB_REQUIRE_PROJECT_INFO=false
# CODEHUB_GIT_SSL_NO_VERIFY=true

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# Disable Claude tools for every session.
# Accepts a comma-separated list or a JSON array.
# Examples: CLAUDE_DISABLED_TOOLS=Bash,Write,AskUserQuestion
# Examples: CLAUDE_DISABLED_TOOLS=["Bash(git push:*)","Write"]
# CLAUDE_DISABLED_TOOLS=

# Python packages installed into newly-created Docker runtimes.
# Separate multiple packages with spaces or commas, e.g. "requests httpx pyyaml".
CLOUDCLI_DOCKER_PYTHON_PACKAGES=requests

# Share Docker-runtime Python user packages and pip's download/wheel cache across
# users. Enabled by default. Packages are separated by Docker image and Python
# minor version, while Claude homes and workspaces remain private per runtime.
# CLOUDCLI_DOCKER_SHARED_PYTHON=true
# CLOUDCLI_DOCKER_PYTHON_SHARED_ROOT=~/.cloudcli/runtimes/.shared/python

# =============================================================================
# CONTAINER STORAGE CONFIGURATION
# =============================================================================

# Native starts default these paths under the current user's home directory.
# Docker Compose starts require explicit absolute host paths. The database
# directory is persisted as a unit so SQLite WAL/journal files are retained.
# Create all three directories on the Docker host before starting the UI.
# The host HOME is not mounted; the UI uses an isolated cloudcli-home volume.
# CLOUDCLI_DATA_ROOT=/data/db
# DATABASE_PATH=/data/db/auth.db
# WORKSPACES_ROOT=/data/workspaces
# CLOUDCLI_RUNTIME_ROOT=/data/runtimes

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Optional AES-256 key for encrypting stored USER_KEY values.
# Use a 64-character hex value when another service, such as a Python decryptor, must share the key.
# PROXY_ENCRYPTION_KEY=000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000
